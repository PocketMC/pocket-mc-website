{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "name": "pocketmc",
  "title": "PocketMC Server Manager",
  "description": "Model Context Protocol server exposing tools to manage local Minecraft server instances, Java runtimes, tunnels, and console commands.",
  "version": "1.9.10",
  "protocolVersion": "2025-11-25",
  "websiteUrl": "https://pocketmc.github.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/PocketMC/pocket-mc-windows"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "http://127.0.0.1:25580/mcp"
    },
    {
      "type": "sse",
      "url": "http://127.0.0.1:25580/sse"
    }
  ],
  "capabilities": {
    "tools": {
      "listChanged": false
    },
    "resources": {
      "subscribe": false,
      "listChanged": false
    }
  },
  "tools": [
    {
      "name": "list_instances",
      "description": "List all configured Minecraft server instances and their operational state",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "get_instance_status",
      "description": "Get detailed runtime status, memory, CPU, and player metrics for a specific server instance",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the server instance"
          }
        },
        "required": ["id"]
      }
    },
    {
      "name": "start_instance",
      "description": "Start a specific Minecraft server instance by ID",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the server instance"
          }
        },
        "required": ["id"]
      }
    },
    {
      "name": "stop_instance",
      "description": "Gracefully stop a running Minecraft server instance with save-all flush",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the server instance"
          }
        },
        "required": ["id"]
      }
    },
    {
      "name": "send_console_command",
      "description": "Send a command to the Minecraft server console",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the server instance"
          },
          "command": {
            "type": "string",
            "description": "Console command to execute (e.g. 'say Hello')"
          }
        },
        "required": ["id", "command"]
      }
    }
  ]
}
